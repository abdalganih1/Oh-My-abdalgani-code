{
  "name": "abdalgani-gateway",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "OpenRouter-style AI gateway on Cloudflare Workers + D1 (coupons, wallets, multi-provider routing)",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply abdalgani-gateway --local",
    "db:migrate": "wrangler d1 migrations apply abdalgani-gateway --remote",
    "test": "node --test --no-warnings test/*.test.js",
    "build:web": "vite build --config web/vite.config.js",
    "dev:web": "vite --config web/vite.config.js"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^4.5.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.5",
    "tailwindcss": "^4.1.8",
    "vite": "^6.3.5",
    "wrangler": "^4.40.0"
  }
}
